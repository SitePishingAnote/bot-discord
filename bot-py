import os
import discord
from discord.ext import commands
from dotenv import load_dotenv

load_dotenv()

TOKEN = os.getenv("DISCORD_TOKEN")
GUILD_ID = int(os.getenv("GUILD_ID"))
CHAT_GERAL_ID = int(os.getenv("CHAT_GERAL_ID"))

intents = discord.Intents.default()
intents.members = True
intents.message_content = True

bot = commands.Bot(command_prefix="!", intents=intents)


@bot.event
async def on_ready():
    print(f"Bot conectado como {bot.user} (ID: {bot.user.id})")
    print("------")


@bot.event
async def on_member_join(member: discord.Member):
    # 1) manda DM
    try:
        await member.send(f"oi {member.name}! bem-vindo(a) ao servidor 💫")
    except discord.Forbidden:
        print(f"Não consegui mandar DM pra {member.name} (DM fechada)")

    # 2) manda mensagem no chat-geral
    canal = bot.get_channel(CHAT_GERAL_ID)
    if canal is None:
        print("Canal chat-geral não encontrado. Confere o CHAT_GERAL_ID no .env")
        return

    msg = await canal.send(
        f"{member.mention} entrou no servidor! seja bem-vindo(a) 🎉"
    )

    # 3) fixa a nova mensagem
    try:
        pins = await canal.pins()
        if len(pins) >= 50:
            pins_sem_sistema = [p for p in pins if p.type == discord.MessageType.default]
            if pins_sem_sistema:
                await pins_sem_sistema[-1].unpin()

        await msg.pin()
    except discord.Forbidden:
        print("Sem permissão pra gerenciar/fixar mensagens. Verifica Manage Messages.")


bot.run(TOKEN)
